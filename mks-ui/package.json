{
  "name": "@npm-scope/mks-ui",
  "version": "0.1.0",
  "description": "Reusable MUI-based React components extracted from mks_webapp (POC).",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsdown",
    "check:dist": "node scripts/check-use-client.mjs && node scripts/check-externals.mjs",
    "check:publint": "publint --strict",
    "check:types": "attw --pack .",
    "check:pack": "node scripts/check-pack.mjs",
    "verify": "npm run clean && npm run typecheck && npm run lint && npm run test && npm run build && npm run check:dist && npm run check:publint && npm run check:types && npm run check:pack",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "@mui/material": "^5.14.0",
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@eslint/js": "10.0.1",
    "@mui/material": "5.18.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "eslint": "10.12.0",
    "jsdom": "27.4.0",
    "publint": "0.3.25",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
